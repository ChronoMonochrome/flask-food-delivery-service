FROM nginx:alpine

# Remove the default nginx configuration file to replace it with ours
RUN rm /etc/nginx/conf.d/default.conf

# Copy your custom nginx configuration file into the appropriate Nginx directory
# Note: We're copying it to /etc/nginx/nginx.conf, which is the main config file,
# rather than conf.d/ to simplify our setup.
COPY nginx.conf /etc/nginx/nginx.conf

# Create a directory inside the container for SSL certificates.
# These will be populated via Docker volumes.
RUN mkdir -p /etc/nginx/certs

# Expose ports 8080 and 8443 for HTTP and HTTPS traffic
EXPOSE 8080 8443

# Command to start Nginx in the foreground (daemon off) so Docker keeps the container running
CMD ["nginx", "-g", "daemon off;"]


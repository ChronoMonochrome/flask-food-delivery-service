# Stage 1: Build Frontend
# Use a Node.js image to build the frontend assets
FROM node:20-alpine as build-env

# Install git
RUN apk add --no-cache git

# Create a temporary directory for the project source
WORKDIR /usr/src/app/repo_source

# Copy the frontend source into this stage
COPY ./front/ .

# Install frontend dependencies and build the project
# Using --force as in your original file to handle dependency conflicts
RUN npm install --force
RUN npm run build:dev

# Stage 2: Build Flask Application
# Switched from Bullseye to Bookworm to fix the GPG signature/repository errors
FROM python:3.9-slim-bookworm

# Set the working directory in the container
WORKDIR /app

# Install system dependencies
# Added --no-install-recommends to reduce image bloat
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    default-libmysqlclient-dev \
    gcc \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# Copy local requirements.txt and install Python dependencies
COPY back/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the built frontend assets from the build-env stage
# Matches your pathing: /usr/src/app/repo_source/dist -> /app/app/static
COPY --from=build-env /usr/src/app/repo_source/dist /app/app/static

# Set permissions for the static folder recursively
RUN chmod -R 775 /app/app/static

# Copy the Flask application code
COPY back/app /app/app

# Copy the migrations folder
COPY back/migrations /app/migrations

# Expose port 8011 for Gunicorn
EXPOSE 8011

# Copy the entrypoint script
COPY back/entrypoint_web.sh /usr/local/bin/entrypoint_web.sh
RUN chmod +x /usr/local/bin/entrypoint_web.sh

ENTRYPOINT ["entrypoint_web.sh"]
